# ─────────────────────────────────────────────────────────────────────────────
# TrustVault environment template. Copy to `.env` and fill in real values.
# NEVER commit a populated `.env` — it is git-ignored by design.
# ─────────────────────────────────────────────────────────────────────────────

# HTTP port the API listens on.
PORT=3000

# Production PostgreSQL connection string (Neon or self-hosted).
# The application refuses to start in production when this is missing.
DATABASE_URL="postgresql://user:password@host:5432/database?sslmode=require"

# Dedicated, EMPTY database used only by the automated test-suite.
# The test harness refuses to run when this is missing, when it is identical to
# DATABASE_URL, or when its database name does not contain the word "test".
TEST_DATABASE_URL="postgresql://user:password@host:5432/database_test?sslmode=require"

# Secret used to sign session cookies and derive CSRF tokens.
# Must be at least 32 characters and must NOT be the development fallback.
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET="replace-with-a-long-random-value-at-least-32-characters"

# Number of reverse proxies in front of the app (used for correct client IPs
# and for `secure` cookies). 1 means "one trusted proxy".
TRUST_PROXY=1

# Rate limiting (requests per 15-minute window, per client IP).
RATE_LIMIT_API=1000
RATE_LIMIT_AUTH=30

# Optional absolute path for the local file cache. The database blob store
# remains the source of truth; this directory is a write-through cache.
# UPLOAD_DIR=./uploads
